	<parameter name="nis" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("logoSekolah.png")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    s.nis,
    s.nama_siswa,
    s.jkel,
    s.kelas,
    p.tgl_pelanggaran,
    p.kategori_pelanggaran,
    p.keterangan
FROM tbl_siswa s
LEFT JOIN tbl_pelanggaran p ON p.nis = s.nis
WHERE s.nis = $P{nis}
ORDER BY p.tgl_pelanggaran]]>
	</queryString>
	<field name="nis" class="java.lang.Object"/>
	<field name="nama_siswa" class="java.lang.Object"/>
	<field name="jkel" class="java.lang.Object"/>
	<field name="kelas" class="java.lang.Object"/>
	<field name="tgl_pelanggaran" class="java.lang.Object"/>
